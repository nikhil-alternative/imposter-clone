# ---------------------------------------------------------------
# Environment variables for Imposter
#
# Copy this file to .env.local (or set on your host) and fill in
# your values. Only VITE_CONVEX_URL is required by the app.
# ---------------------------------------------------------------

# REQUIRED — Convex deployment URL.
#  - Local dev:  run `npx convex dev`, which writes this automatically
#  - Production: set this on Vercel to your cloud URL, e.g.
#                https://<your-project>.convex.cloud
VITE_CONVEX_URL=http://127.0.0.1:3210

# OPTIONAL — Convex HTTP actions site URL (only needed if you add
# convex/http.ts endpoints). The current app does not use HTTP actions.
# VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
